APP_NAME=Poliorama API
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Substitua pelos dados do PostgreSQL local. Nao versione credenciais reais.
DATABASE_URL=postgresql+asyncpg://app_inteligencia:change_me@localhost:5432/inteligencia_politica
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Storage: local, s3 ou seaweedfs (SeaweedFS usa a API compativel com S3).
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=../data/arquivos
STORAGE_BUCKET=vurix-arquivos
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=true
STORAGE_MAX_FILE_MB=25
PHOTO_MAX_FILE_MB=8
STORAGE_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,pdf,csv,xlsx,xls,doc,docx,odt,txt

# SeaweedFS Filer.
SEAWEED_FILER_URL=http://192.168.18.112:8888
SEAWEED_PROJECT_NAME=poli_orama
SEAWEED_USERNAME=
SEAWEED_PASSWORD=
SEAWEED_TIMEOUT_SECONDS=30

#app_saas\backend_core\src\app\core\integracoes
# Lista separada por virgulas; use apenas origens explicitas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4321,http://127.0.0.1:4321,https://staging.example.com,https://app.example.com

# Checkout hospedado: use "none" enquanto nao houver provedor, ou "sandbox" localmente.
CHECKOUT_PROVIDER=none
CHECKOUT_SANDBOX_URL=https://sandbox.checkout.local/session
PAYMENT_WEBHOOK_SECRET=change-me-in-production

# Gere um segredo aleatorio com pelo menos 32 caracteres em cada ambiente.
JWT_SECRET=local-development-secret-change-me-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=vurix-eleitoral
JWT_AUDIENCE=vurix-eleitoral-api
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
SESSION_IDLE_MINUTES=120
SESSION_TOUCH_INTERVAL_SECONDS=60
PASSWORD_MIN_LENGTH=8
MFA_ISSUER=Poliorama
MFA_ENCRYPTION_KEY=local-mfa-encryption-key-change-me-32-bytes
