	<constraint name="plano_assinatura_preco_mensal_check" type="ck-constr" table="public.plano_assinatura">
			<expression> <![CDATA[(preco_mensal >= (0)::numeric)]]> </expression>
	</constraint>
	<constraint name="plano_assinatura_limite_usuarios_check" type="ck-constr" table="public.plano_assinatura">
			<expression> <![CDATA[((limite_usuarios IS NULL) OR (limite_usuarios > 0))]]> </expression>
	</constraint>
