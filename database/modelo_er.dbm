<function name="tenant_atual"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="global"/>
	<role name="postgres"/>
	<comment> <![CDATA[Retorna o tenant_id corrente definido por SET LOCAL app.current_tenant_id pela aplicacao. Base para as politicas RLS.]]> </comment>
	<language name="plpgsql"/>
	<return-type>
	<type name="bigint" length="0"/>
	</return-type>
	<definition> <![CDATA[
DECLARE
    v_valor TEXT;
BEGIN
    v_valor := current_setting('app.current_tenant_id', TRUE);
    IF v_valor IS NULL OR v_valor = '' THEN
        RETURN NULL;
    END IF;
    RETURN v_valor::BIGINT;
END;
]]> </definition>
</function>

<function name="fn_atualiza_timestamp"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="global"/>
	<role name="postgres"/>
	<comment> <![CDATA[Atualiza automaticamente a coluna atualizado_em em operacoes de UPDATE.]]> </comment>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition> <![CDATA[
BEGIN
    NEW.atualizado_em := now();
    RETURN NEW;
END;
]]> </definition>
</function>

<function name="fn_preenche_tenant"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="global"/>
	<role name="postgres"/>
	<comment> <![CDATA[Preenche automaticamente tenant_id no INSERT com o tenant corrente da sessao quando omitido.]]> </comment>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition> <![CDATA[
BEGIN
    IF NEW.tenant_id IS NULL THEN
        NEW.tenant_id := global.tenant_atual();
    END IF;
    RETURN NEW;
END;
]]> </definition>
</function>

