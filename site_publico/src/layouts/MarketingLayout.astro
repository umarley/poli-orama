---
import BaseLayout from "./BaseLayout.astro";
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  structuredData?: Record<string, unknown>[];
}
const props = Astro.props;
---
<BaseLayout {...props}><slot /></BaseLayout>
