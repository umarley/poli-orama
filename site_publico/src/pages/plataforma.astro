---
import MarketingLayout from "../layouts/MarketingLayout.astro";
const modules = [
  ["Cadastros e relacionamentos", "Centralize registros, segmentações e histórico com acesso controlado.", "/recursos/cadastro-eleitoral"],
  ["Território e mapas", "Organize áreas, locais e atuação da equipe com contexto geográfico.", "/recursos/territorio-mapas"],
  ["Metas e lideranças", "Atribua responsáveis e acompanhe evolução sem confundir meta com comprovação de voto.", "/recursos/metas-liderancas"],
  ["Agenda e demandas", "Conecte compromissos, solicitações, responsáveis, prazos e retornos.", "/recursos/agenda-demandas"],
  ["Comunicação", "Planeje públicos e mensagens com governança e registro das ações.", "/recursos/comunicacao"],
  ["Modo eleição", "Concentre ocorrências e decisões críticas na fase mais intensa da operação.", "/recursos/modo-eleicao"],
];
---
<MarketingLayout title="Plataforma | Vurix Eleitoral" description="Conheça os módulos e o fluxo de dados da plataforma Vurix Eleitoral.">
  <section class="page-hero"><div><span class="eyebrow">PLATAFORMA</span><h1>Uma operação conectada, do cadastro à decisão.</h1><p>A Vurix organiza processos que normalmente ficam espalhados entre planilhas, mensagens e ferramentas sem integração.</p><div class="actions left"><a class="button" href="/demo">Agendar demonstração</a><a class="button secondary" href="/planos">Comparar planos</a></div></div><div class="metric-panel"><strong>Visão por permissão</strong><span>Equipe de campo</span><span>Coordenação</span><span>Gestão</span><span>Administradores</span></div></section>
  <section class="section"><div class="section-heading"><span class="eyebrow">MÓDULOS</span><h2>Recursos que compartilham contexto</h2></div><div class="feature-grid">{modules.map(([title, text, href], index) => <article class="feature-card"><span class="feature-number">{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{text}</p><a href={href}>Conhecer recurso →</a></article>)}</div></section>
  <section class="section split-section"><div><span class="eyebrow">FLUXO DE DADOS</span><h2>Registre uma vez. Use com responsabilidade.</h2><p>Informações autorizadas alimentam segmentações, tarefas, territórios e indicadores respeitando o perfil de acesso de cada usuário.</p></div><ol class="steps"><li>A equipe registra ou importa dados no ambiente autenticado.</li><li>Regras de acesso limitam a visualização ao necessário.</li><li>Atividades atualizam o histórico operacional.</li><li>Painéis consolidam indicadores para a coordenação.</li></ol></section>
  <section class="cta-band"><div><span class="eyebrow">CONHEÇA O FLUXO</span><h2>Uma demonstração objetiva, baseada no seu cenário.</h2></div><a class="button light" href="/demo">Solicitar demo</a></section>
</MarketingLayout>
